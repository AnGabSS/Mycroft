# ---- Mycroft API ----
# Host port where the API (and Scalar docs at /scalar/v1) is exposed
MYCROFT_PORT=8080
# Interface the port is published on. 127.0.0.1 = this machine only. Use 0.0.0.0 to expose to the network,
# and only together with MYCROFT_API_KEY.
MYCROFT_BIND_ADDRESS=127.0.0.1
# When set, every /api/* request must send the header "X-Api-Key: <value>". /health, /openapi and /scalar stay public.
# Generate one with: openssl rand -hex 32
MYCROFT_API_KEY=

# ---- Local SLM (Ollama) ----
# Any Ollama model with good structured output: llama3.2:3b (default, CPU friendly), phi3:mini, llama3.1:8b
OLLAMA_MODEL=llama3.2:3b
# Concurrent requests sent to Ollama (1-2 on modest hardware avoids OOM / CPU contention)
MAX_CONCURRENT_SLM_REQUESTS=1
# Transactions per prompt. 3B models degrade on long lists; raise to 10-15 with 7B+ models
SLM_CHUNK_SIZE=8
# CPU-only inference of a 15-item chunk can take minutes; keep this generous
SLM_REQUEST_TIMEOUT_SECONDS=600
# Load the model at API startup so the first job is not slowed by the cold start
SLM_WARMUP=true
# How long Ollama keeps the model in memory after the last request (default in Ollama is only 5m)
OLLAMA_KEEP_ALIVE=24h
# Write high-confidence SLM answers to the global merchant cache automatically.
# Off by default: small models are confidently wrong, and cached mistakes are replayed forever.
# With false, the cache learns only from PATCH /transactions/{id}/feedback.
SLM_AUTO_LEARN=false
# Results below this confidence are flagged needsReview=true
NEEDS_REVIEW_THRESHOLD=0.70

# ---- Guardrails ----
MAX_UPLOAD_SIZE_MB=10
MAX_ITEMS_PER_JOB=2000
WORKER_CONCURRENCY=1
# Days to keep jobs/transactions. MerchantPatterns and Categories are kept forever.
RETENTION_DAYS=7

# ---- Webhooks ----
# Signs webhooks of jobs that do not send their own webhookSecret (optional)
WEBHOOK_DEFAULT_SECRET=
WEBHOOK_TIMEOUT_SECONDS=15

# ---- PostgreSQL ----
POSTGRES_DB=mycroft
POSTGRES_USER=mycroft
POSTGRES_PASSWORD=change-me
